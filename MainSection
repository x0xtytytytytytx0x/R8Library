local function themeSnapToJson(snap)
	local out={}
	if type(snap)~="table" then return out end
	for ck,cv in pairs(snap)do
		if typeof(cv)=="Color3" then out[ck]=colorToT(cv)
		elseif type(cv)=="table" and cv.r~=nil then out[ck]={r=tonumber(cv.r)or 1,g=tonumber(cv.g)or 1,b=tonumber(cv.b)or 1}
		elseif type(cv)=="boolean" or type(cv)=="number" or type(cv)=="string" then out[ck]=cv
		end
	end
	return out
end
local function themeJsonToSnap(data)
	local t={}
	if type(data)~="table" then return t end
	for k,v in pairs(data)do
		if k=="_name" then
			-- keep for key resolution, not as theme color field
		elseif type(v)=="table" and v.r~=nil then t[k]=tToColor(v)
		elseif type(v)=="boolean" or type(v)=="number" or type(v)=="string" then t[k]=v
		end
	end
	return t
end
local function loadCustomThemes()
	if not Themes then return end
	ensureDir(SAVE_ROOT)
	ensureDir(SAVE_THEMES_DIR)
	-- legacy single-file migrate
	local legacy=readJson(SAVE_ROOT.."/themes.json")
	if type(legacy)=="table" then
		local migrated={}
		for name,snap in pairs(legacy)do
			if type(name)=="string" and type(snap)=="table" then
				Themes[name]=themeJsonToSnap(snap)
				local payload=themeSnapToJson(Themes[name])
				payload._name=name
				writeJson(themeFilePath(name), payload)
				table.insert(migrated,name)
			end
		end
		if #migrated>0 then writeThemeIndex(migrated) end
	end
	local loaded={}
	local function tryLoad(label)
		if type(label)~="string" or label=="" or label=="_index" then return end
		local data=readJson(themeFilePath(label))
		if type(data)~="table" then
			-- try raw filename without rewriting
			data=readJson(SAVE_THEMES_DIR.."/"..label..".json")
		end
		if type(data)~="table" then return end
		local key=(type(data._name)=="string" and data._name~="") and data._name or label
		if key:sub(1,7)~="Custom " then key="Custom "..key end
		Themes[key]=themeJsonToSnap(data)
		table.insert(loaded,key)
		print("[R8//TW0] loaded theme",key)
	end
	for _,fname in ipairs(listThemeFiles()) do tryLoad(fname) end
	-- rebuild index from what we actually loaded + existing customs
	local names={}
	for k in pairs(Themes) do
		if type(k)=="string" and k:sub(1,7)=="Custom " then table.insert(names,k) end
	end
	if #names>0 then writeThemeIndex(names) end
end
local function saveOneTheme(name,snap)
	if type(name)~="string" or type(snap)~="table" then return false end
	pcall(ensureDir, SAVE_THEMES_DIR)
	local payload=themeSnapToJson(snap) or {}
	payload._name=name
	local ok=writeJson(themeFilePath(name), payload)
	if ok then
		pcall(function()
			local names=readThemeIndex() or {}
			local found=false
			for _,n in ipairs(names) do if n==name then found=true break end end
			if not found then table.insert(names,name) end
			writeThemeIndex(names)
		end)
		-- always register in the live theme maps (never assume a local upvalue)
		pcall(function()
			local map = (UILibrary and UILibrary.Themes) or Themes
			if type(map)=="table" then map[name]=snap end
		end)
		pcall(function()
			if type(Themes)=="table" then Themes[name]=snap end
		end)
	end
	return ok==true
end
local function saveCustomThemes()
	if not Themes then return false end
	local allOk,any=true,false
	local names={}
	for k,v in pairs(Themes)do
		if type(k)=="string" and k:sub(1,7)=="Custom " and type(v)=="table" then
			any=true
			table.insert(names,k)
			if not saveOneTheme(k,v) then allOk=false end
		end
	end
	writeThemeIndex(names)
	return any and allOk
end
local function deleteCustomTheme(name)
	if type(name)~="string" or name:sub(1,7)~="Custom " then return false end
	Themes[name]=nil
	deleteThemeFile(name)
	return true
end

