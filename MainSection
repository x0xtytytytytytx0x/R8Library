local RainbowHue = 0
local RainbowTargets = {}
local RainbowConn = nil
local function ensureRainbowLoop()
	if RainbowConn then return end
	RainbowConn = RunService.Heartbeat:Connect(function(dt)
		if next(RainbowTargets)==nil then return end
		RainbowHue = (RainbowHue + dt * 0.08) % 1
		local col = Color3.fromHSV(RainbowHue, 1, 1)
		for _, fn in pairs(RainbowTargets) do
			pcall(fn, col)
		end
	end)
end
local function registerRainbow(id, fn)
	RainbowTargets[id] = fn
	ensureRainbowLoop()
end
local function unregisterRainbow(id)
	RainbowTargets[id] = nil
end

