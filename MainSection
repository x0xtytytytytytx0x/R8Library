local THEME_INDEX_PATH=SAVE_THEMES_DIR.."/_index.json"
local function readThemeIndex()
	local data=readJson(THEME_INDEX_PATH)
	local names={}
	if type(data)=="table" then
		if data.names then
			for _,n in ipairs(data.names) do if type(n)=="string" then table.insert(names,n) end end
		else
			for _,n in ipairs(data) do if type(n)=="string" then table.insert(names,n) end end
		end
	end
	return names
end
local function writeThemeIndex(names)
	local uniq,out={},{}
	for _,n in ipairs(names or {}) do
		if type(n)=="string" and n~="" and not uniq[n] then
			uniq[n]=true
			table.insert(out,n)
		end
	end
	table.sort(out)
	return writeJson(THEME_INDEX_PATH,{names=out})
end
local function listThemeFiles()
	local files={}
	local seen={}
	local function add(n)
		if type(n)~="string" or n=="" or n=="_index" then return end
		if seen[n] then return end
		seen[n]=true
		table.insert(files,n)
	end
	-- 1) index (reliable on executors without listfiles)
	for _,n in ipairs(readThemeIndex()) do add(n) end
	-- 2) listfiles if available
	if fsOk() then
		pcall(function()
			if typeof(listfiles)=="function" then
				for _,p in ipairs(listfiles(SAVE_THEMES_DIR) or {}) do
					local n=tostring(p):match("([^/\\]+)%.json$")
					if n and n~="_index" then add(n) end
				end
			end
		end)
	end
	-- 3) Themes table already in memory
	if Themes then
		for k in pairs(Themes) do
			if type(k)=="string" and k:sub(1,7)=="Custom " then add(k) end
		end
	end
	return files
end
local function deleteThemeFile(themeName)
	if not fsOk() then return false end
	local path=themeFilePath(themeName)
	local ok=pcall(function()
		if typeof(delfile)=="function" then delfile(path) end
	end)
	-- drop from index
	local names=readThemeIndex()
	local next={}
	for _,n in ipairs(names) do if n~=themeName then table.insert(next,n) end end
	writeThemeIndex(next)
	return ok==true
end
local function colorToT(c)if typeof(c)~="Color3" then return nil end return{r=c.R,g=c.G,b=c.B}end
local function tToColor(t)if type(t)~="table" then return nil end return Color3.new(tonumber(t.r)or 1,tonumber(t.g)or 1,tonumber(t.b)or 1)end
local function keyName(k)if typeof(k)=="EnumItem" then return k.Name end if type(k)=="string" then return k end return nil end
