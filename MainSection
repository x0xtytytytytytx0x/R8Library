function Window:SetAntiAfk(on)
	self.AntiAfk = on and true or false
	local lp = Players.LocalPlayer
	if self._antiAfkConn then pcall(function() self._antiAfkConn:Disconnect() end) self._antiAfkConn=nil end
	if not on or not lp then return end
	if getconnections then
		pcall(function()
			for _, c in ipairs(getconnections(lp.Idled)) do
				pcall(function() c:Disable() end)
				pcall(function() c:Disconnect() end)
			end
		end)
	end
	self._antiAfkConn = lp.Idled:Connect(function()
		pcall(function()
			local vim = Instance.new("VirtualInputManager")
			vim:SendMouseButtonEvent(0, 0, 0, true, game, 1)
			vim:SendMouseButtonEvent(0, 0, 0, false, game, 1)
			vim:Destroy()
		end)
	end)
end

function Window:SetSuperMaxZoom(on)
	self.SuperMaxZoom = on and true or false
	local lp = Players.LocalPlayer
	if not lp then return end
	if on then
		if self._savedMaxZoom == nil then self._savedMaxZoom = lp.CameraMaxZoomDistance end
		lp.CameraMaxZoomDistance = 9999
	else
		lp.CameraMaxZoomDistance = self._savedMaxZoom or 128
	end
end

function Window:ApplyNamehide()
	if not self.ScreenGui then return end
	local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then return end
	local candidates = {}
	for _, child in ipairs(pg:GetChildren()) do
		if child:IsA("ScreenGui") and child ~= self.ScreenGui then
			table.insert(candidates, child.Name)
		end
	end
	local decoys = {"ScreenFadeUI","LoadingGui","CoreNotify","PlayerList","BubbleChat","TouchGui","Health","Chat","TopBar","MenuUI","HUD","MainGui"}
	for _, d in ipairs(decoys) do table.insert(candidates, d) end
	local pick = candidates[math.random(1, math.max(1,#candidates))]
	pcall(function() self.ScreenGui.Name = pick end)
	self._namehideName = pick
end

