function Window:_RunOwnerTool(key, url)
	self._ownerToolLoaded = self._ownerToolLoaded or {}
	if self._ownerToolLoaded[key] then
		self:Notify({title="Already loaded", text=key.." was already loaded this session.", icon=DEFAULT_ICON, duration=3})
		return false
	end
	local ok, err = pcall(function()
		local src = httpGet(url)
		if not src or src == "" then error("empty response") end
		local fn, compileErr = loadstring(src)
		if not fn then error(compileErr or "compile failed") end
		fn()
	end)
	if ok then
		self._ownerToolLoaded[key] = true
		self:Notify({title="Loaded", text=key.." loaded.", icon=DEFAULT_ICON, duration=3})
		return true
	end
	self:Notify({title="Load failed", text=key..": "..tostring(err), icon=DEFAULT_ICON, duration=5})
	return false
end

