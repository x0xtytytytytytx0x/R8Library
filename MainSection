		if self._refreshThemeDropdown then self._refreshThemeDropdown() end
	end
	settingsTab:CreateButton({
		name="Delete selected custom theme",
		buttonText="Delete",
		starrable=false,
		callback=function()
			local name = nil
			if delDrop then
				if delDrop.Get then name=delDrop:Get() elseif delDrop.get then name=delDrop.get() end
			end
			if type(name)~="string" or name:sub(1,7)~="Custom " then
				self:Notify({title="Delete",text="Pick a Custom theme first.",icon=DEFAULT_ICON,duration=3})
				return
			end
			deleteCustomTheme(name)
			if self.ThemeName==name then self:SetTheme("R8TW0") end
			if self._refreshCustomThemeList then self._refreshCustomThemeList() end
			self:Notify({title="Deleted",text=name.." removed.",icon=DEFAULT_ICON,duration=3})
		end,
	})
	pcall(function()self:CreateSearchTab()end)
	return settingsTab
end

