function Window:SaveSettings()
	writeJson(SAVE_SETTINGS,self:_CollectSettings())
end
function Window:_ApplySettings(s)
	if type(s)~="table" then return end
	if s.themeName and Themes[s.themeName]then self:SetTheme(s.themeName)end
	if s.matrixEnabled~=nil then self:SetMatrixEnabled(s.matrixEnabled)end
	if typeof(s.matrixDensity)=="number" and self.MatrixBorder and self.MatrixBorder.SetDensity then self.MatrixDensity=s.matrixDensity self.MatrixBorder.SetDensity(s.matrixDensity)end
	if s.soundsEnabled~=nil then self.SoundsEnabled=s.soundsEnabled and true or false end
	if s.nameplatesEnabled~=nil then self.NameplatesEnabled=s.nameplatesEnabled and true or false if self.Nameplates then self.Nameplates.SetEnabled(self.NameplatesEnabled)end end
	if s.hideMarks~=nil then self.HideMarks=s.hideMarks and true or false self:RefreshMarks()end
	if s.dragBounds~=nil then self.DragBounds=s.dragBounds and true or false end
	if s.resizable~=nil then if self.SetResizable then self:SetResizable(s.resizable)else self.Resizable=s.resizable and true or false end end
	if s.buttonKeybindsEnabled~=nil then self:SetButtonKeybindsEnabled(s.buttonKeybindsEnabled)end
	local mk=keyFromName(s.minimizeKeybind)if mk then self.MinimizeKeybind=mk end
	local hk=keyFromName(s.hideKeybind)if hk then self.HideKeybind=hk end
	if s.bgImage and s.bgImage~="" then self:SetBackgroundImage(s.bgImage,s.bgTransparency)elseif typeof(s.bgTransparency)=="number" and self.BgImage then self.BgBaseTransparency=s.bgTransparency self.BgImage.ImageTransparency=s.bgTransparency self.BgImage:SetAttribute("BaseTransparency",s.bgTransparency)end
	if s.windowIcon and s.windowIcon~="" then self:SetWindowIcon(s.windowIcon)end
	if s.skipFakeLoading~=nil then self.SkipFakeLoading=s.skipFakeLoading and true or false end
	if s.ownerInfiniteYield~=nil then self.OwnerInfiniteYield=s.ownerInfiniteYield and true or false end
	if s.ownerUnnamedESP~=nil then self.OwnerUnnamedESP=s.ownerUnnamedESP and true or false end
	if s.antiAfk~=nil then self:SetAntiAfk(s.antiAfk and true or false) end
	if s.superMaxZoom~=nil then self:SetSuperMaxZoom(s.superMaxZoom and true or false) end
	if s.placesAutoCleanup~=nil then self.PlacesAutoCleanup=s.placesAutoCleanup and true or false end
	if s.namehideUi~=nil then self.NamehideUi=s.namehideUi and true or false if self.NamehideUi then self:ApplyNamehide() end end
end
function Window:LoadSettings()
	local s=readJson(SAVE_SETTINGS)if s then self:_ApplySettings(s)end
end
function Window:_PlaceName()
	local n=nil
	pcall(function()
		local info=game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
		if info and info.Name then n=info.Name end
	end)
	if not n or n=="" then n=tostring(game.PlaceId) end
	return n
end
function Window:_PlacePath()
	return SAVE_PLACES.."/"..safeFileName(self:_PlaceName())..".json"
end
function Window:_CollectPlace()
	local stars={}for k,_ in pairs(self.Starred or{})do table.insert(stars,k)end
	local binds={}for _,ctrl in ipairs(self.Keybindables or{})do if ctrl.getKey and ctrl.getKey()then local kn=keyName(ctrl.getKey())local label=ctrl._label or nil if kn and label then binds[label]=kn end end end
	for name,meta in pairs(self.ControlRegistry or{})do if meta.getKey then local k=meta.getKey()if k then binds[meta.name or name]=keyName(k)end end end
	return{placeId=game.PlaceId,placeName=self:_PlaceName(),stars=stars,keybinds=binds,lastUsed=os.time()}
end
function Window:SavePlace()
	writeJson(self:_PlacePath(),self:_CollectPlace())
end
function Window:CleanupOldPlaces()
	if not self.PlacesAutoCleanup then return end
	if not fsOk() or typeof(listfiles)~="function" then return end
	local cutoff=os.time()-(30*24*60*60)
	pcall(function()
		for _,p in ipairs(listfiles(SAVE_PLACES) or {}) do
			if tostring(p):match("%.json$") then
				local data=readJson(p)
				local last=type(data)=="table" and tonumber(data.lastUsed)
				if last and last<cutoff then
					pcall(function()if typeof(delfile)=="function" then delfile(p)end end)
				end
			end
		end
	end)
end
function Window:SaveAll()
	self:SaveSettings()
	saveCustomThemes()
	self:SavePlace()
end
function Window:LoadPlace()
	local data=readJson(self:_PlacePath())
	if type(data)~="table" then data=readJson(SAVE_PLACES.."/"..tostring(game.PlaceId)..".json") end
	if type(data)~="table" then self._pendingStars={}self._pendingKeybinds={}return end
	self._pendingStars={}
	if type(data.stars)=="table" then for _,k in ipairs(data.stars)do self._pendingStars[k]=true end end
	self._pendingKeybinds={}
	if type(data.keybinds)=="table" then for n,kn in pairs(data.keybinds)do self._pendingKeybinds[n]=kn end end
	data.lastUsed=os.time()
	data.placeName=data.placeName or self:_PlaceName()
	data.placeId=data.placeId or game.PlaceId
	writeJson(self:_PlacePath(),data)
	self:CleanupOldPlaces()
end
function Window:ApplyPendingKeybind(label,ctrl)
	if not label or not ctrl then return end
	local kn=self._pendingKeybinds and self._pendingKeybinds[label]
	if not kn then return end
	local key=keyFromName(kn)
	if not key then return end
	-- force-write into controller if it exposes internals via set; we stored boundKey only inside closure
	-- use map directly
	self._buttonKeybinds=self._buttonKeybinds or{}
	if ctrl._action then self._buttonKeybinds[key]=ctrl._action end
	if ctrl._setBoundKey then ctrl._setBoundKey(key)end
end
