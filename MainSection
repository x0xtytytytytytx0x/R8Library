local function httpGet(url)
	local ok,body=pcall(function()
		if typeof(game.HttpGet)=="function" then return game:HttpGet(url) end
		if typeof(http)=="table" and http.request then
			local r=http.request({Url=url,Method="GET"})
			return r.Body or r.body or ""
		end
		if typeof(request)=="function" then
			local r=request({Url=url,Method="GET"})
			return r.Body or r.body or ""
		end
		return game:GetService("HttpService"):GetAsync(url)
	end)
	if ok and type(body)=="string" then return body end
	return nil
end
local function parseIdList(body)
	local list={}
	if type(body)~="string" then return list end
	for line in body:gmatch("[^\r\n]+") do
		line=line:gsub("^%s+",""):gsub("%s+$","")
		if line~="" and not line:match("^#") and not line:match("^//") then
			-- allow "12345" or "12345 -- name" or comma-separated on one line
			for token in line:gmatch("[%d]+") do
				local n=tonumber(token)
				if n and n>0 then table.insert(list,n) end
			end
		end
	end
	return list
end
local function loadAccess()
	AccessLists.owners={}
	AccessLists.verified={}
	local o=httpGet(OWNER_LIST_URL)
	local v=httpGet(VERIFIED_LIST_URL)
	if o then AccessLists.owners=parseIdList(o) end
	if v then AccessLists.verified=parseIdList(v) end
end
local function listHas(list,id)
	id=tonumber(id)
	if not id then return false end
	for _,v in ipairs(list)do if tonumber(v)==id then return true end end
