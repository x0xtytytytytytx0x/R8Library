local function readJson(path)if not fsOk()then return nil end local ok,data=pcall(function()if typeof(isfile)=="function" and not isfile(path)then return nil end return readfile(path)end)if not ok or not data then return nil end return jsonDec(data)end
local function writeJson(path,tbl)if not fsOk()then print("[R8//TW0] no filesystem (writefile/readfile missing)") return false end ensureDir(SAVE_ROOT)ensureDir(SAVE_THEMES_DIR)ensureDir(SAVE_PLACES)local s=jsonEnc(tbl)if not s then print("[R8//TW0] JSONEncode failed",path) return false end local ok,err=pcall(function()writefile(path,s)end) if not ok then print("[R8//TW0] writefile failed",path,tostring(err)) else print("[R8//TW0] wrote",path) end return ok==true end
local function safeFileName(name)
